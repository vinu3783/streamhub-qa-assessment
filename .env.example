# Base URL of the Loan Analytics Dashboard under test.
# `npm run dev` serves on 5173; `npm run preview` (production build) serves on 4173.
BASE_URL=http://localhost:5173

# Base URL of the external API used by the A3 API tests.
API_BASE_URL=https://jsonplaceholder.typicode.com

# Browser options for UI tests.
HEADLESS=true
BROWSER=chromium
# Default Playwright timeout (ms) for UI actions and assertions.
DEFAULT_TIMEOUT_MS=10000

# Optional: enables the LLM step of the self-healing POC (tools/self-healing).
# Without it the POC uses its deterministic candidate generator only.
# ANTHROPIC_API_KEY=
# HEAL_MODEL=claude-sonnet-5-5
