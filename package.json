{
  "name": "loan-analytics-dashboard",
  "version": "1.0.0",
  "description": "Loan Analytics Dashboard — Streamhub Fullstack + QA Automation Assessment (Section A)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview --strictPort",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cucumber-js --profile default",
    "test:ui": "cucumber-js --profile ui",
    "test:api": "cucumber-js --profile api",
    "test:api:assessment-expectations": "cucumber-js --profile apiAssessmentExpectations",
    "test:sql": "cucumber-js --profile sql",
    "test:self-healing": "cucumber-js --profile selfHealing",
    "sql": "node --disable-warning=ExperimentalWarning --import tsx scripts/run-sql.ts",
    "heal": "tsx tools/self-healing/heal.ts"
  },
  "author": "Vinayaka",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "chart.js": "^4.5.1",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "zod": "^4.6.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
